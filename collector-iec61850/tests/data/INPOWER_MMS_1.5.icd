	<Header id="RUISHAN-RS100" toolID="AI_Builder" nameStructure="IEDName">
		<History>
			<Hitem version="2.0.0" revision="1.0.0" when="2026-03-10" who="AI" what="Split from merged V1.7. Pure MMS Server with original datasets preserved." />
		</History>
	</Header>
	<Substation name="inPower">
		<VoltageLevel name="110kV">
			<Bay name="PCS" />
		</VoltageLevel>
	</Substation>
	<Communication>
		<SubNetwork desc="StationBus" name="SubNetwork_Stationbus" type="8-MMS">
			<ConnectedAP iedName="PCS0001" apName="S1">
				<Address>
					<P type="OSI-AP-Title">1 3 9999 106</P>
					<P type="OSI-AE-Qualifier">33</P>
					<P type="OSI-PSEL">00 00 00 01</P>
					<P type="OSI-SSEL">00 01</P>
					<P type="OSI-TSEL">00 01</P>
					<P type="IP">192.168.1.136</P>
					<P type="IP-SUBNET">255.255.255.0</P>
					<P type="IP-GATEWAY">192.168.1.1</P>
				</Address>
				<!-- GOOSE 组播配置已移除 -->
				<PhysConn type="Connection">
					<P type="Port">9-A</P>
					<P type="Type">100BaseT</P>
					<P type="Cable">D1</P>
					<P type="Plug">RJ45</P>
				</PhysConn>
				<PhysConn type="RedConn">
					<P type="Port">9-B</P>
					<P type="Type">100BaseT</P>
					<P type="Cable">D2</P>
					<P type="Plug">RJ45</P>
				</PhysConn>
			</ConnectedAP>
		</SubNetwork>
	</Communication>
	<IED name="PCS0001" desc="RS100_PCS" type="RS-100" manufacturer="RUISHAN" configVersion="2.0">
		<Services>
