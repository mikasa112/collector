{
  "product_type": "开发机测试",
  "project": "开发机测试",
  "program": {
    "emu": {
      "enable": false
    },
    "http": {
      "enable": true,
      "ip": "0.0.0.0",
      "port": 9091
    },
    "mod": {
      "enable": true,
      "path": "lua_scripts"
    },
    "north_modbus": {
      "enable": true,
      "north_modbus_host": "0.0.0.0",
      "north_modbus_port": 9092,
      "north_modbus_conf": "./config/北向/MODBUS_REGISTERS.xlsx"
    },
    "north_iec104": {
      "enable": false,
      "host": "0.0.0.0",
      "port": 2404,
      "conf": "./config/北向/IEC104_SERVER.xlsx",
      "max_connections": 0,
      "multi_master": false,
      "select_timeout_ms": 30000,
      "require_select": false
    },
    "coordinator": {
      "enable": false,
      "id": "agc",
      "tick_ms": 500,
      "upstream_timeout_ms": 60000,
      "p_deadband": 1.0,
      "q_deadband": 1.0,
      "members": [
        {
          "dev": "ctrl_a", "rated_kva": 500.0,
          "p_set": 1, "q_set": 2, "p_actual": 3, "q_actual": 4,
          "p_upper": 5, "p_lower": 6, "q_upper": 7, "q_lower": 8
        },
        {
          "dev": "ctrl_b", "rated_kva": 500.0,
          "p_set": 1, "q_set": 2, "p_actual": 3, "q_actual": 4,
          "p_upper": 5, "p_lower": 6, "q_upper": 7, "q_lower": 8
        }
      ]
    },
    "eg25_gl": {
      "enable": false
    },
    "mqtt": {
      "enable": false,
      "mqtt_host": "127.0.0.1",
      "mqtt_port": 1883,
      "mqtt_username": "root",
      "mqtt_password": "inpower",
      "mqtt_yt": "/asw/+/+/yt",
      "mqtt_yk": "/asw/+/+/yk"
    }
  },
  "devices": {
    "pcs": {
      "id": "pcs",
      "type": "PCS",
      "desc": "英博电气125kWPCS",
      "config": {
        "type": "PCS",
        "com_type": "ModbusTCP",
        "register_file": "./config/pcs/PCS_英博_125.xlsx",
        "interval": 2000,
        "timeout": 2000,
        "ip": "127.0.0.1",
        "port": 10000,
        "slave": 1,
        "serial_tty": null,
        "baud_rate": null,
        "data_bits": null,
        "parity": null,
        "stop_bits": null,
        "interface": null,
        "desc": null,
        "request_interval": null,
        "max_gap": null
      }
    }
  }
}
