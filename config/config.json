{
  "product_type": "EMS",
  "project": "万润2.5MW/5MWh EMS",
  "program": {
    "emu": {
      "enable": false
    },
    "http": {
      "enable": true,
      "ip": "0.0.0.0",
      "port": 9091
    },
    "mod": {
      "enable": true,
      "path": "lua_scripts"
    },
    "north_modbus": {
      "enable": false,
      "north_modbus_host": "0.0.0.0",
      "north_modbus_port": 9092,
      "north_modbus_conf": "./config/MODBUS_REGISTERS.xlsx"
    },
    "north_iec104": {
      "enable": false,
      "host": "0.0.0.0",
      "port": 2404,
      "conf": "./config/北向/IEC104_SERVER.xlsx",
      "max_connections": 0,
      "multi_master": false,
      "select_timeout_ms": 30000,
      "require_select": false
    },
    "coordinator": {
      "enable": false,
      "id": "agc",
      "tick_ms": 500,
      "upstream_timeout_ms": 60000,
      "p_deadband": 1,
      "q_deadband": 1,
      "positive_is_discharge": true,
      "members": [
        {
          "dev": "ctrl_a",
          "rated_kva": 2500.0,
          "p_set": 2005,
          "q_set": 2006,
          "p_actual": 13,
          "q_actual": 14,
          "p_max_charge": 19,
          "p_max_discharge": 20
        },
        {
          "dev": "ctrl_b",
          "rated_kva": 2500.0,
          "p_set": 2005,
          "q_set": 2006,
          "p_actual": 13,
          "q_actual": 14,
          "p_max_charge": 19,
          "p_max_discharge": 20
        }
      ]
    },
    "eg25_gl": {
      "enable": false
    },
    "mqtt": {
      "enable": false,
      "mqtt_host": "127.0.0.1",
      "mqtt_port": 1883,
      "mqtt_username": "root",
      "mqtt_password": "inpower",
      "mqtt_yt": "/asw/+/+/yt",
      "mqtt_yk": "/asw/+/+/yk"
    }
  },
