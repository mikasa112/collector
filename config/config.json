{
  "product_type": "EMU",
  "project": "英博自研电池管理系统",
  "program": {
    "emu": {
      "enable": true
    },
    "http": {
      "enable": true,
      "ip": "0.0.0.0",
      "port": 9091
    },
    "mod": {
      "enable": true,
      "path": "lua_scripts"
    },
    "north_modbus": {
      "enable": true,
      "north_modbus_host": "0.0.0.0",
      "north_modbus_port": 9092,
      "north_modbus_conf": "./config/MODBUS_REGISTERS.xlsx"
    },
    "eg25_gl": {
      "enable": true
    },
    "mqtt": {
      "enable": true,
      "mqtt_host": "127.0.0.1",
      "mqtt_port": 1883,
      "mqtt_username": "root",
      "mqtt_password": "inpower",
      "mqtt_yt": "/asw/+/+/yt",
      "mqtt_yk": "/asw/+/+/yk"
    }
  },
  "devices": {
    "pcs": {
      "id": "pcs",
      "type": "PCS",
      "desc": "英博电气125kWPCS",
      "config": {
        "type": "PCS",
        "com_type": "ModbusTCP",
        "register_file": "./config/pcs/PCS_英博_125.xlsx",
        "interval": 1000,
        "timeout": 2000,
        "ip": "192.168.0.20",
        "port": 502,
        "slave": 1,
        "serial_tty": null,
        "baud_rate": null,
        "data_bits": null,
        "parity": null,
        "stop_bits": null,
        "interface": null,
        "desc": null,
        "request_interval": null,
        "max_gap": null
      }
    },
    "bcu": {
      "id": "bcu",
      "type": "BCU",
      "desc": "永泰BMS系统",
      "config": {
        "type": "BCU",
        "com_type": "CAN",
        "register_file": "./config/bms/BCU_永泰.xlsx",
        "interval": 2000,
        "timeout": 5000,
        "ip": null,
        "port": null,
        "slave": null,
        "serial_tty": null,
        "baud_rate": 500000,
        "data_bits": null,
        "parity": null,
        "stop_bits": null,
        "interface": "can0",
        "desc": null,
        "request_interval": null,
        "max_gap": null
      }
    },
    "dehum": {
      "id": "dehum",
      "type": "Dehum",
      "desc": "除湿机",
      "config": {
        "type": "Dehum",
        "com_type": "ModbusRTU",
        "register_file": "./config/辅控/除湿机.xlsx",
        "interval": 2000,
        "timeout": 2000,
        "ip": null,
        "port": null,
        "slave": 2,
        "serial_tty": "/dev/ttyXRUSB1",
        "baud_rate": 9600,
        "data_bits": 8,
        "parity": "N",
        "stop_bits": 1,
        "interface": null,
        "desc": null,
        "request_interval": null,
        "max_gap": null
      }
    },
    "tms": {
      "id": "tms",
      "type": "TMS",
      "desc": "液冷机组",
      "config": {
        "type": "TMS",
        "com_type": "ModbusRTU",
        "register_file": "./config/液冷机组/水冷机组_埃森特.xlsx",
        "interval": 2000,
        "timeout": 2000,
        "ip": null,
        "port": null,
        "slave": 1,
        "serial_tty": "/dev/ttyXRUSB3",
        "baud_rate": 9600,
        "data_bits": 8,
        "parity": "N",
        "stop_bits": 1,
        "interface": null,
        "desc": null,
        "request_interval": null,
        "max_gap": null
      }
    },
    "fire": {
      "id": "fire",
      "type": "FIRE",
      "desc": "消防系统",
      "config": {
        "type": "FIRE",
        "com_type": "ModbusRTU",
        "register_file": "./config/辅控/消防温感烟感.xlsx",
        "interval": 2000,
        "timeout": 2000,
        "ip": null,
        "port": null,
        "slave": 1,
        "serial_tty": "/dev/ttyXRUSB2",
        "baud_rate": 9600,
        "data_bits": 8,
        "parity": "N",
        "stop_bits": 1,
        "interface": null,
        "desc": null,
        "request_interval": null,
        "max_gap": null
      }
    },
    "gpio": {
      "id": "gpio",
      "type": "GPIO",
      "desc": "DIDO",
      "config": {
        "type": "GPIO",
        "com_type": "GPIO",
        "register_file": "./config/gpio/GPIO.xlsx",
        "interval": 2000,
        "timeout": 2000,
        "ip": null,
        "port": null,
        "slave": null,
        "serial_tty": null,
        "baud_rate": null,
        "data_bits": null,
        "parity": null,
        "stop_bits": null,
        "interface": null,
        "desc": null,
        "request_interval": null,
        "max_gap": null
      }
    }
  }
}
